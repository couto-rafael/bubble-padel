{
  "name": "bubble-padel-api",
  "version": "1.0.0",
  "description": "API backend Bubble Padel",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed:smoke": "tsx scripts/seed-smoke-test-athletes.ts",
    "seed:smoke:dry": "tsx scripts/seed-smoke-test-athletes.ts --dry-run",
    "seed:tournament": "tsx scripts/seed-tournament-regular.ts",
    "seed:tournament:dry": "tsx scripts/seed-tournament-regular.ts --dry-run",
    "seed:scores": "tsx scripts/seed-tournament-scores.ts",
    "seed:scores:dry": "tsx scripts/seed-tournament-scores.ts --dry-run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^5.10.0",
    "@sentry/node": "^10.45.0",
    "@supabase/supabase-js": "^2.103.0",
    "@types/multer": "^2.1.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.19.0",
    "resend": "^6.9.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.18.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
