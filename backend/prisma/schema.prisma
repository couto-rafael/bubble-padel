generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserType {
  CLUB
  ATHLETE
}

enum Sport {
  PADEL
  BEACH_TENNIS
  TENIS
  PICKLEBALL
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  OPEN
  CLOSED
  ONGOING
  COMPLETED
}

enum TeamStatus {
  CONFIRMED
  PENDING
}

enum ChargeStatus {
  PENDING
  PAID
  EXPIRED
  REFUNDED
}

enum LeagueMemberStatus {
  INVITED
  ACTIVE
}

enum TrophyPlacement {
  CHAMPION
  RUNNER_UP
}

enum AchievementTier {
  BRONZE
  SILVER
  GOLD
  DIAMOND
  LEGEND
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS & PROFILES
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  type         UserType
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  club         Club?
  athlete      Athlete?
  notifications Notification[]

  @@map("users")
}

model Club {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  cnpj             String?
  city             String         @default("")
  state            String         @default("")
  phone            String?
  logoUrl          String?
  courts           String[]       @default([])
  matchDuration    Int            @default(60)
  defaultStartTime String         @default("08:00")
  defaultEndTime   String         @default("20:00")
  // Sprint 7B — endereço completo
  cep              String?
  street           String?
  addressNumber    String?
  neighborhood     String?
  // perfil público
  coverUrl         String?
  slogan           String?
  description      String?
  sports           Sport[]        @default([])
  amenities        String[]       @default([])
  businessHours    Json?
  paymentMethods   Json?
  pixKeys          Json?
  whatsappNumber   String?
  instagramUrl     String?
  youtubeUrl       String?
  twitterUrl       String?
  threadsUrl       String?
  instructors      ClubInstructor[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tournaments      Tournament[]
  leaguesCreated   League[]       @relation("LeaguesCreated")
  leagueMemberships LeagueMember[]

  // Sprint 10 — social
  followers         AthleteFollowsClub[] @relation("ClubFollowers")

  @@map("clubs")
}

model ClubInstructor {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  photoUrl  String?
  sports    Sport[]  @default([])
  bio       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("club_instructors")
}

model Athlete {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  cpf          String?
  phone        String?
  birthDate    DateTime?
  city         String?
  state        String?
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Sprint 7 — perfil Strava
  firstName    String?           // Nome (separado do sobrenome)
  lastName     String?           // Sobrenome
  nickname     String?           // Apelido/nome de guerra
  bio          String?           // Bio pública (max 300 chars)
  gender       String?           // MASCULINO | FEMININO | NAO_INFORMAR
  bannerUrl    String?           // URL do banner do perfil
  sports       Sport[]           @default([])  // Esportes que pratica
  rackets      String[]          @default([])  // Marcas/modelos das raquetes
  instagramUrl String?           // Handle ou URL do Instagram
  twitterUrl   String?           // Handle ou URL do Twitter/X

  // Sprint 5 — gamificação
  trophies     AthleteTrophy[]
  achievements AthleteAchievement[]
  leaguePoints LeaguePoints[]

  // Sprint 9 — patrocinadores
  sponsors          AthleteSponsor[]

  // Sprint 10 — social
  friendshipsSent     AthleteFriendship[] @relation("FriendshipSent")
  friendshipsReceived AthleteFriendship[] @relation("FriendshipReceived")
  followingClubs      AthleteFollowsClub[] @relation("AthleteFollowsClubs")
  posts               AthletePost[]

  // Configurações de privacidade e notificações
  settings          Json      @default("{}")

  @@map("athletes")
}

// ─────────────────────────────────────────────────────────────────────────────
// TOURNAMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Tournament {
  id                     String           @id @default(cuid())
  clubId                 String
  club                   Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name                   String
  sport                  Sport            @default(PADEL)
  tournamentType         String           @default("Grupos + Playoffs")
  startDate              DateTime
  endDate                DateTime
  registrationStartDate  DateTime?
  registrationEndDate    DateTime?
  description            String           @default("")
  status                 TournamentStatus @default(DRAFT)
  maxTeams               Int              @default(32)
  priceFirstCategory     Float            @default(0)
  hasSecondCategoryPrice Boolean          @default(false)
  priceSecondCategory    Float            @default(0)
  pixKey                 String           @default("")
  clubSede               String           @default("")
  categories             String[]
  matchDuration          Int              @default(60)
  daySchedules           Json             @default("[]")
  courts                 String[]
  reminderSentAt         DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  teams                  Team[]
  groups                 Group[]
  playoffs               PlayoffBracket[]
  league                 LeagueTournament?
  super8Players          Super8Player[]
  super8Matches          Super8Match[]

  @@map("tournaments")
}

// ─────────────────────────────────────────────────────────────────────────────
// TEAMS & PAYMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Team {
  id                   String       @id @default(cuid())
  tournamentId         String
  tournament           Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1Name          String
  player1Email         String
  player2Name          String
  player2Email         String
  category             String
  status               TeamStatus   @default(PENDING)
  player1PaymentStatus ChargeStatus @default(PENDING)
  player2PaymentStatus ChargeStatus @default(PENDING)
  player1ChargeId      String?
  player2ChargeId      String?
  amount               Float        @default(0)
  registrationDate     DateTime     @default(now())
  hasRestriction       Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  groupTeams           GroupTeam[]
  payments             Payment[]

  @@map("teams")
}

model Payment {
  id           String       @id @default(cuid())
  teamId       String
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tournamentId String
  playerNumber Int
  playerEmail  String
  amount       Float
  status       ChargeStatus @default(PENDING)
  externalId   String?
  pixCode      String?
  pixQrCode    String?
  paymentToken String?      @unique
  emailSentAt  DateTime?
  paidAt       DateTime?
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([teamId, playerNumber])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// GROUPS, MATCHES, SCHEDULE, PLAYOFFS
// ─────────────────────────────────────────────────────────────────────────────

model Group {
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  category     String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  teams        GroupTeam[]
  matches      Match[]

  @@map("groups")
}

model GroupTeam {
  id            String  @id @default(cuid())
  groupId       String
  group         Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  position      Int     @default(0)
  wins          Int     @default(0)
  losses        Int     @default(0)
  pointsFor     Int     @default(0)
  pointsAgainst Int     @default(0)
  saldo         Int     @default(0)
  gamesPlayed   Int     @default(0)
  qualified     Boolean @default(false)

  @@unique([groupId, teamId])
  @@map("group_teams")
}

model Match {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  team1Id   String
  team2Id   String
  score1    Int?
  score2    Int?
  played    Boolean  @default(false)
  wo        Int?
  sets      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("matches")
}

model Schedule {
  id        String    @id @default(cuid())
  matchId   String    @unique
  court     String
  date      DateTime?
  time      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("schedules")
}

model PlayoffBracket {
  id           String         @id @default(cuid())
  tournamentId String
  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category     String
  matches      PlayoffMatch[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([tournamentId, category])
}

model PlayoffMatch {
  id         String         @id @default(cuid())
  bracketId  String
  bracket    PlayoffBracket @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  roundSize  Int
  matchIndex Int
  team1Id    String?
  team2Id    String?
  team1Label String?
  team2Label String?
  score1     Int?
  score2     Int?
  winnerId   String?
  isBye      Boolean        @default(false)
  played     Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// SPRINT 11 — SUPER 8
// ─────────────────────────────────────────────────────────────────────────────

model Super8Player {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  order        Int
  wins         Int        @default(0)
  losses       Int        @default(0)
  gamesFor     Int        @default(0)
  gamesAgainst Int        @default(0)
  createdAt    DateTime   @default(now())

  @@map("super8_players")
}

model Super8Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  matchIndex   Int
  team1p1      Int
  team1p2      Int
  team2p1      Int
  team2p2      Int
  score1       Int?
  score2       Int?
  played       Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("super8_matches")
}

model Reconciliation {
  id           String   @id @default(cuid())
  tournamentId String   @unique
  totalBruto   Float
  comissao     Float
  valorRepasse Float
  totalAtletas Int
  status       String   @default("PENDENTE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("reconciliations")
}

// ─────────────────────────────────────────────────────────────────────────────
// SPRINT 5 — LIGAS
// ─────────────────────────────────────────────────────────────────────────────

model League {
  id              String   @id @default(cuid())
  name            String
  description     String   @default("")
  sport           Sport?
  createdByClubId String
  createdByClub   Club     @relation("LeaguesCreated", fields: [createdByClubId], references: [id], onDelete: Cascade)
  pointsChampion  Int      @default(100)
  pointsRunnerUp  Int      @default(70)
  pointsSemi      Int      @default(45)
  pointsQuarter   Int      @default(25)
  pointsGroup     Int      @default(10)
  pointsRound16   Int?
  pointsRound32   Int?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  members         LeagueMember[]
  tournaments     LeagueTournament[]
  points          LeaguePoints[]

  @@map("leagues")
}

model LeagueMember {
  id        String             @id @default(cuid())
  leagueId  String
  league    League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  clubId    String
  club      Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  status    LeagueMemberStatus @default(INVITED)
  invitedAt DateTime           @default(now())
  joinedAt  DateTime?

  @@unique([leagueId, clubId])
  @@map("league_members")
}

model LeagueTournament {
  id             String     @id @default(cuid())
  leagueId       String
  league         League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  tournamentId   String     @unique
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  pointsChampion Int?
  pointsRunnerUp Int?
  pointsSemi     Int?
  pointsQuarter  Int?
  pointsGroup    Int?
  pointsRound16  Int?
  pointsRound32  Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("league_tournaments")
}

model LeaguePoints {
  id           String   @id @default(cuid())
  leagueId     String
  league       League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  athleteId    String
  athlete      Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  tournamentId String
  category     String
  placement    String
  points       Int
  earnedAt     DateTime @default(now())

  @@unique([leagueId, athleteId, tournamentId, category])
  @@map("league_points")
}

// ─────────────────────────────────────────────────────────────────────────────
// SPRINT 5 — TROFÉUS & ACHIEVEMENTS
// ─────────────────────────────────────────────────────────────────────────────

model AthleteTrophy {
  id             String          @id @default(cuid())
  athleteId      String
  athlete        Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  tournamentId   String
  tournamentName String
  category       String
  placement      TrophyPlacement
  sport          Sport           @default(PADEL)
  earnedAt       DateTime        @default(now())

  @@unique([athleteId, tournamentId, category])
  @@map("athlete_trophies")
}

model AthleteAchievement {
  id         String           @id @default(cuid())
  athleteId  String
  athlete    Athlete          @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  key        String
  tier       AchievementTier
  progress   Int              @default(0)
  unlockedAt DateTime?
  updatedAt  DateTime         @updatedAt

  @@unique([athleteId, key])
  @@map("athlete_achievements")
}

// ─────────────────────────────────────────────────────────────────────────────
// ATHLETE SPONSORS (Sprint 9)
// ─────────────────────────────────────────────────────────────────────────────

model AthleteSponsor {
  id         String   @id @default(cuid())
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  name       String
  logoUrl    String?
  publicId   String?
  websiteUrl String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([athleteId, order])
  @@map("athlete_sponsors")
}

// ─────────────────────────────────────────────────────────────────────────────
// SPRINT 10 — SOCIAL (Conexões, Seguir, Mensagens, Notificações)
// ─────────────────────────────────────────────────────────────────────────────

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum PostType {
  MANUAL
  TROPHY
  TOURNAMENT_JOIN
  MATCH_RESULT
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  NEW_MESSAGE
  TOURNAMENT_INVITE
  CLUB_NEW_TOURNAMENT
  BADGE_UNLOCKED
  RANKING_CHANGE
}

model AthleteFriendship {
  id         String           @id @default(cuid())
  senderId   String
  sender     Athlete          @relation("FriendshipSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   Athlete          @relation("FriendshipReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendshipStatus @default(PENDING)
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@map("athlete_friendships")
}

model AthletePost {
  id         String    @id @default(cuid())
  athleteId  String
  athlete    Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  type       PostType  @default(MANUAL)
  content    String?
  imageUrl   String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([athleteId, createdAt])
  @@map("athlete_posts")
}

model AthleteFollowsClub {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation("AthleteFollowsClubs", fields: [athleteId], references: [id], onDelete: Cascade)
  clubId    String
  club      Club     @relation("ClubFollowers", fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([athleteId, clubId])
  @@map("athlete_follows_club")
}

model Message {
  id           String   @id @default(cuid())
  senderId     String
  senderType   UserType
  receiverId   String
  receiverType UserType
  content      String
  readAt       DateTime?
  createdAt    DateTime @default(now())

  @@map("messages")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@map("notifications")
}
